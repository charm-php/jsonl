{
    "name": "charm/jsonl",
    "description": "Fast JSON Lines (NDJSON) encoding and decoding in PHP: an Encoder and an incremental Decoder that accepts input in arbitrary chunks.",
    "type": "library",
    "license": "MIT",
    "keywords": ["jsonl", "json lines", "ndjson", "json", "encoder", "decoder", "incremental"],
    "authors": [
        {
            "name": "Frode Børli",
            "email": "frode@ennerd.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Charm\\Jsonl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Charm\\Jsonl\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
